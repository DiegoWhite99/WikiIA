# ===== WikiIA - configuración local =====
# Copia este archivo como .env y llena tus datos.  (El .env real NUNCA se comparte.)

# Motor de IA: auto = Groq primero y Ollama de respaldo | groq | ollama
LLM_PROVEEDOR=auto

# Groq (nube, rápido, plan gratis con límites): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-120b

# Ollama (local, gratis, sin internet): https://ollama.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:3b

# Alertas por Telegram (opcional): crea un bot con @BotFather y obtén tu chat id con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cuántos modelos investigar con IA en cada actualización automática
INVESTIGAR_POR_EJECUCION=25

# Modo público (solo lectura: sin Configuración, investigar ni editar). Vacío = automático:
# se activa solo en Streamlit Cloud. 1 = forzarlo · 0 = desactivarlo
WIKIIA_PUBLICO=

# Calendario de lanzamientos publicado por el workflow en GitHub Pages, y la app publicada
WIKIIA_CALENDARIO_URL=https://diegowhite99.github.io/WikiIA/wikiia.ics
WIKIIA_APP_URL=https://wikiia-bl3pec2wdfzvcxdg9jq5aw.streamlit.app/

# Canal público de Telegram (opcional): pon aquí su enlace t.me/... para mostrar el botón "📱 Telegram".
# Para que las alertas lleguen al canal: agrega tu bot como administrador y usa TELEGRAM_CHAT_ID=@nombre_del_canal
TELEGRAM_CANAL_URL=
